# --- AI -------------------------------------------------------------------
# One key is enough. Without either, the app runs in demo mode on the worked
# example from the build plan.
#
# Claude is used when both keys are present: the pipeline's prompts and its
# web-search pass were written against it.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=

# Gemini, from Google AI Studio. The project id is not a secret — it names the
# Google Cloud project the key belongs to, and is reported by /api/health so a
# misconfigured key is diagnosable from one request.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=gen-lang-client-0865070384
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- Storage (optional) ---------------------------------------------------
# Leave these blank and the app keeps the last analysis in localStorage only,
# which is the v1 behaviour. Set them to keep analyses and generate share
# links. Run supabase/schema.sql once in the SQL editor first.
# SUPABASE_SERVICE_ROLE_KEY is preferred; the publishable/anon key works too
# because the table has no client-side policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
