# --- AI -------------------------------------------------------------------
# Without a key the app runs in demo mode on the worked example from the
# build plan. Add a key to analyse your own text.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=

# --- Storage (optional) ---------------------------------------------------
# Leave these blank and the app keeps the last analysis in localStorage only,
# which is the v1 behaviour. Set them to keep analyses and generate share
# links. Run supabase/schema.sql once in the SQL editor first.
# SUPABASE_SERVICE_ROLE_KEY is preferred; the publishable/anon key works too
# because the table has no client-side policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
